# High-contrast colored echo for black background
mecho() {
    local mode=$1
    shift
    local text="$*"

    # Color definitions
    local RED="\e[91m"
    local GREEN="\e[92m"
    local YELLOW="\e[93m"
    local BLUE="\e[94m"
    local CYAN="\e[96m"
    local LIGHT_GRAY="\e[37m"
    local GRAY="\e[90m"
    local NC="\e[0m"  # reset

    case "$mode" in
        success)
            echo -e "${GREEN}${text}${NC}"
            ;;
        warning)
            echo -e "${YELLOW}${text}${NC}"
            ;;
        error)
            echo -e "${RED}${text}${NC}"
            ;;
        info)
            echo -e "${CYAN}${text}${NC}"
            ;;
        notice)
            echo -e "${BLUE}${text}${NC}"
            ;;
        debug)
            echo -e "${LIGHT_GRAY}${text}${NC}"
            ;;
        trace)
            echo -e "${GRAY}${text}${NC}"
            ;;
        *)
            # Unknown mode handling
            echo -e "${RED}[ERROR] Unknown mode: '${mode}'${NC}" >&2
            echo "Available modes:" >&2
            echo "  success, warning, error, info, notice, debug, trace" >&2
            return 1
            ;;
    esac
}
