_shistory_file() {
    echo "${SZHU_SUBMIT_DIR:-/lustre/alice/users/tcheng/szhu/work/sys}/history_submission"
}

_shistory_log_sresubmit() {
    local history_file="$1"
    shift

    {
        date
        printf 'sresubmit'
        printf ' %q' "$@"
        printf '\n'
    } >> "$history_file"
}

_shistory_find_submit_line() {
    local job_name="$1"
    local history_file="$2"

    awk -v job_name="$job_name" '
        function has_exact_job_name(line, fields, n, i) {
            n = split(line, fields, /[[:space:]]+/)
            for (i = 1; i < n; i++) {
                if (fields[i] == "-n" && fields[i + 1] == job_name) {
                    return 1
                }
            }
            return 0
        }

        $1 == "sresubmit" {
            next
        }

        has_exact_job_name($0) {
            line = $0
        }

        END {
            if (line != "") {
                print line
            }
        }
    ' "$history_file" 2>/dev/null
}

_shistory_find_run_id() {
    local job_name="$1"
    local history_file="$2"

    awk -v job_name="$job_name" '
        function has_exact_job_name(line, fields, n, i) {
            n = split(line, fields, /[[:space:]]+/)
            for (i = 1; i < n; i++) {
                if (fields[i] == "-n" && fields[i + 1] == job_name) {
                    return 1
                }
            }
            return 0
        }

        $1 == "sresubmit" {
            waiting_for_job_id = 0
            next
        }

        waiting_for_job_id {
            if (match($0, /Submitted batch job[[:space:]]+[0-9]+/)) {
                run_id = substr($0, RSTART, RLENGTH)
                sub(/^Submitted batch job[[:space:]]+/, "", run_id)
            }
            waiting_for_job_id = 0
        }

        has_exact_job_name($0) {
            waiting_for_job_id = 1
        }

        END {
            if (run_id != "") {
                print run_id
            }
        }
    ' "$history_file" 2>/dev/null
}

shistory() {
    local job_name="$1"
    local history_file
    local run_id

    history_file="$(_shistory_file)"

    if [[ -z "$job_name" ]]; then
        echo "usage: shistory <job_name>"
        return 1
    fi

    if [[ ! -f "$history_file" ]]; then
        echo "history file not found: $history_file"
        return 1
    fi

    run_id="$(_shistory_find_run_id "$job_name" "$history_file")"

    if [[ -z "$run_id" ]]; then
        echo "no such job"
        return 1
    fi

    sacct -j "$run_id"
}

_shistory() {
    local cur opts history_file
    local -a job_names

    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    opts="-h --help"

    history_file="$(_shistory_file)"

    # 保持 COMPREPLY 的原始顺序，不按字典序重新排序
    compopt -o nosort 2>/dev/null

    if [[ "$cur" == -* ]]; then
        COMPREPLY=($(compgen -W "$opts" -- "$cur"))
        return 0
    fi

    if [[ -f "$history_file" ]]; then
        mapfile -t job_names < <(
            awk '
                {
                    for (i = 1; i < NF; i++) {
                        if ($i == "-n") {
                            print $(i + 1)
                        }
                    }
                }
            ' "$history_file" 2>/dev/null \
            | tac \
            | awk 'NF && !seen[$0]++'
        )

        COMPREPLY=($(compgen -W "${job_names[*]}" -- "$cur"))
    fi

    return 0
}

swhich() {
    local job_name="$1"
    local history_file
    local path_job

    history_file="$(_shistory_file)"

    if [[ -z "$job_name" ]]; then
        echo "usage: swhich <job_name>"
        return 1
    fi

    if [[ ! -f "$history_file" ]]; then
        echo "history file not found: $history_file"
        return 1
    fi

    path_job="$(_shistory_find_submit_line "$job_name" "$history_file")"

    if [[ -z "$path_job" ]]; then
        echo "no such job"
        return 1
    fi

    echo "$path_job"
}

sresubmit() {
    local source_job="$1"
    shift || true

    local history_file original_line
    local partition="" job_name="" time_limit="" dependency="" array_spec=""
    local path_env="" path_command="" ncommands_onefile=""
    local -a original_args override_args submit_args override_positionals
    local arg next i

    history_file="$(_shistory_file)"

    if [[ -z "$source_job" ]]; then
        echo "usage: sresubmit <job_name> [-p partition] [-n job_name] [-t time_limit] [-a array_spec] [--dependency dependency_spec] [path_env] [path_command] [ncommands_onefile]"
        return 1
    fi

    if [[ ! -f "$history_file" ]]; then
        echo "history file not found: $history_file"
        return 1
    fi

    original_line="$(_shistory_find_submit_line "$source_job" "$history_file")"
    if [[ -z "$original_line" ]]; then
        echo "no such job"
        return 1
    fi

    _shistory_log_sresubmit "$history_file" "$source_job" "$@"

    read -r -a original_args <<< "$original_line"

    i=0
    while [[ $i -lt ${#original_args[@]} ]]; do
        arg="${original_args[i]}"
        case "$arg" in
            -p)
                partition="${original_args[i+1]}"
                i=$((i + 2))
                ;;
            -n)
                job_name="${original_args[i+1]}"
                i=$((i + 2))
                ;;
            -t)
                time_limit="${original_args[i+1]}"
                i=$((i + 2))
                ;;
            -a)
                array_spec="${original_args[i+1]}"
                i=$((i + 2))
                ;;
            --dependency)
                dependency="${original_args[i+1]}"
                i=$((i + 2))
                ;;
            *)
                if [[ -z "$path_env" ]]; then
                    path_env="$arg"
                elif [[ -z "$path_command" ]]; then
                    path_command="$arg"
                elif [[ -z "$ncommands_onefile" ]]; then
                    ncommands_onefile="$arg"
                else
                    echo "Error: saved submit command has too many positional arguments: $original_line"
                    return 1
                fi
                i=$((i + 1))
                ;;
        esac
    done

    override_args=("$@")
    override_positionals=()
    i=0
    while [[ $i -lt ${#override_args[@]} ]]; do
        arg="${override_args[i]}"
        case "$arg" in
            -p)
                next="${override_args[i+1]}"
                if [[ -z "$next" ]]; then echo "Error: -p requires a value"; return 1; fi
                partition="$next"
                i=$((i + 2))
                ;;
            -n)
                next="${override_args[i+1]}"
                if [[ -z "$next" ]]; then echo "Error: -n requires a value"; return 1; fi
                job_name="$next"
                i=$((i + 2))
                ;;
            -t)
                next="${override_args[i+1]}"
                if [[ -z "$next" ]]; then echo "Error: -t requires a value"; return 1; fi
                time_limit="$next"
                i=$((i + 2))
                ;;
            -a)
                next="${override_args[i+1]}"
                if [[ -z "$next" ]]; then echo "Error: -a requires a value"; return 1; fi
                array_spec="$next"
                i=$((i + 2))
                ;;
            --dependency)
                next="${override_args[i+1]}"
                if [[ -z "$next" ]]; then echo "Error: --dependency requires a value"; return 1; fi
                dependency="$next"
                i=$((i + 2))
                ;;
            -*)
                echo "Error: unsupported option for sresubmit: $arg"
                return 1
                ;;
            *)
                override_positionals+=("$arg")
                i=$((i + 1))
                ;;
        esac
    done

    if [[ ${#override_positionals[@]} -gt 3 ]]; then
        echo "Error: too many positional arguments"
        return 1
    fi
    [[ ${#override_positionals[@]} -ge 1 ]] && path_env="${override_positionals[0]}"
    [[ ${#override_positionals[@]} -ge 2 ]] && path_command="${override_positionals[1]}"
    [[ ${#override_positionals[@]} -ge 3 ]] && ncommands_onefile="${override_positionals[2]}"

    if [[ -z "$path_env" || -z "$path_command" ]]; then
        echo "Error: saved submit command is missing path_env or path_command: $original_line"
        return 1
    fi

    submit_args=()
    [[ -n "$partition" ]] && submit_args+=("-p" "$partition")
    [[ -n "$job_name" ]] && submit_args+=("-n" "$job_name")
    [[ -n "$time_limit" ]] && submit_args+=("-t" "$time_limit")
    [[ -n "$array_spec" ]] && submit_args+=("-a" "$array_spec")
    [[ -n "$dependency" ]] && submit_args+=("--dependency" "$dependency")
    submit_args+=("$path_env" "$path_command")
    [[ -n "$ncommands_onefile" ]] && submit_args+=("$ncommands_onefile")

    echo "Resubmitting: submit ${submit_args[*]}"
    submit "${submit_args[@]}"
}

complete -F _shistory shistory
complete -F _shistory swhich
complete -F _shistory sresubmit
