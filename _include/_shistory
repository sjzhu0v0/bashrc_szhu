shistory() {
    local job_name="$1"
    local history_file="${SZHU_SUBMIT_DIR:-/lustre/alice/users/tcheng/szhu/work/sys}/history_submission"
    local run_id

    if [[ -z "$job_name" ]]; then
        echo "usage: shistory <job_name>"
        return 1
    fi

    if [[ ! -f "$history_file" ]]; then
        echo "history file not found: $history_file"
        return 1
    fi

    run_id=$(
        awk -v job_name="$job_name" '
            function has_exact_job_name(line, fields, n, i) {
                n = split(line, fields, /[[:space:]]+/)
                for (i = 1; i < n; i++) {
                    if (fields[i] == "-n" && fields[i + 1] == job_name) {
                        return 1
                    }
                }
                return 0
            }

            waiting_for_job_id {
                if (match($0, /Submitted batch job[[:space:]]+[0-9]+/)) {
                    run_id = substr($0, RSTART, RLENGTH)
                    sub(/^Submitted batch job[[:space:]]+/, "", run_id)
                }
                waiting_for_job_id = 0
            }

            has_exact_job_name($0) {
                waiting_for_job_id = 1
            }

            END {
                if (run_id != "") {
                    print run_id
                }
            }
        ' "$history_file" 2>/dev/null
    )

    if [[ -z "$run_id" ]]; then
        echo "no such job"
        return 1
    fi

    sacct -j "$run_id"
}

_shistory() {
    local cur opts history_file
    local -a job_names

    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    opts="-h --help"

    history_file="${SZHU_SUBMIT_DIR:-/lustre/alice/users/tcheng/szhu/work/sys}/history_submission"

    # 保持 COMPREPLY 的原始顺序，不按字典序重新排序
    compopt -o nosort 2>/dev/null

    if [[ "$cur" == -* ]]; then
        COMPREPLY=($(compgen -W "$opts" -- "$cur"))
        return 0
    fi

    if [[ -f "$history_file" ]]; then
        mapfile -t job_names < <(
            awk '
                {
                    for (i = 1; i < NF; i++) {
                        if ($i == "-n") {
                            print $(i + 1)
                        }
                    }
                }
            ' "$history_file" 2>/dev/null \
            | tac \
            | awk 'NF && !seen[$0]++'
        )

        COMPREPLY=($(compgen -W "${job_names[*]}" -- "$cur"))
    fi

    return 0
}

swhich() {
    local job_name="$1"
    local history_file="${SZHU_SUBMIT_DIR:-/lustre/alice/users/tcheng/szhu/work/sys}/history_submission"

    if [[ -z "$job_name" ]]; then
        echo "usage: swhich <job_name>"
        return 1
    fi

    if [[ ! -f "$history_file" ]]; then
        echo "history file not found: $history_file"
        return 1
    fi

    local path_job
    path_job=$(
        awk -v job_name="$job_name" '
            {
                for (i = 1; i < NF; i++) {
                    if ($i == "-n" && $(i + 1) == job_name) {
                        line = $0
                    }
                }
            }
            END {
                if (line != "") {
                    print line
                }
            }
        ' "$history_file" 2>/dev/null
    )

    if [[ -z "$path_job" ]]; then
        echo "no such job"
        return 1
    fi

    echo "$path_job"
}

complete -F _shistory shistory
complete -F _shistory swhich
